    "deny": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Bash(kubectl delete*)",
      "Bash(helm uninstall*)",
      "Read(./.env*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git tag*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(helm upgrade*)",
      "Bash(kubectl apply*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "includeCoAuthoredBy": false
}
