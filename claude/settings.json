      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(cargo *)",
      "Bash(cmake *)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(helm template*)",
      "Bash(helm lint*)",
      "Bash(helm dependency*)",
      "Bash(kubectl get*)",
      "Bash(KUBECONFIG=./kcfg_k0rdent kubectl get*)",
      "Bash(kubectl describe*)",
      "Bash(kubectl logs*)",
      "Bash(kubectl explain*)",
      "Bash(kubectl port-forward*)",
      "Bash(helm get*)",
      "Bash(helm version*)",
      "Bash(helm unittest*)",
      "Bash(KUBECONFIG=./kcfg_um1 kubectl *)",
